{
   x=1;
   y=2;
   sff = <<x+y>>;
   sf  = <x+y>;
   sfsff = <sff>;
   sffsf = <<sf>>;
   sfsf  = <sf>;
   sffsff = <<sff>>;

   x=-2;
   rsff   = sff;
   rsf    = sf;
   rsfsff = sfsff;
   rsffsf = sffsf;
   rsfsf  = sfsf;
   rsffsff= sffsff;
}
