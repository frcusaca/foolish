      1
  };
  chainˍjx={
      4;
      5;
      6;
      3;
      2;
      1
  };
  myfn={WOCONSTANIC
      result=Op+(?(pattern='^a$', UNANCHORED, ECONSTANIC), ?(pattern='^b$', UNANCHORED, ECONSTANIC), WOCONSTANIC)
  };
  btˍfn={
      a=10;
      b=20;
      result=30
  };
  jxˍfn={
      a=10;
      b=20;
      result=30
  };
  extractˍbt=20;
  dotˍval=30;
  headˍval=10;
  tailˍval=30;
  findˍa=10;
  idxˍ0=10;
  fwdˍa=10;
  container={
      inner={
          x=7
      };
      applied={
          y=3;
          x=7
      };
      z=3
  };
  ltˍtrue='True;
  ltˍfalse='False;
  eqˍtrue='True;
  base={
      p=100
  };
  sfˍbt={
      q=150;
      p=100
  };
  sfˍjx={
      q=150;
      p=100
  };
  first={
      a=1;
      b=2;
      result=3
  };
  second={
      a=100;
      b=200;
      result=300
  };
  doubleˍbt={
      a=1;
      b=2;
      result=3;
      a=100;
      b=200;
      result=300
  }
}!!
