{
	!! FOOP-55: ite — if-then-else mechanism
	!! {cond, then, else, 'ite}$ selects then or else based on cond

	r1 = ({'True, 42, 99, 'ite})$;     !! → 42
	r2 = ({'False, 42, 99, 'ite})$;    !! → 99
}
!!
{WOCONSTANIC
  r1 =$ {WOCONSTANIC (WOCONSTANIC)
      ?(result='True, pattern='^'True$', UNANCHORED);
      42;
      99;
      ?(pattern='^'ite$', UNANCHORED, ECONSTANIC)
  };
  r2 =$ {WOCONSTANIC (WOCONSTANIC)
      ?(result='False, pattern='^'False$', UNANCHORED);
      42;
      99;
      ?(pattern='^'ite$', UNANCHORED, ECONSTANIC)
  }
}!!
