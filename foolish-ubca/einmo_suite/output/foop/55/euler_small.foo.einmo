{
	!! FOOP-55: euler_small — the exercise algorithm with bound 10
	!! Expected answer: 23 (3+5+6+9)
	!! Sum of multiples of 3 or 5 below 10

	INTERNAL_ite = {
		cond='True, <<#-3>>;
		cond='False, <<#-2>>;
	}
	'ite = ({<<#-2>>, <<#-1>>} INTERNAL_ite)~cond=(<<#-3>>)&#1

	INTERNAL_cmod = {INTERNAL_eq, {INTERNAL_numerator,INTERNAL_divisor, 'mod}$, 'eq};
	'cmod = {INTERNAL_numerator=#-3,INTERNAL_divisor=#-3,INTERNAL_eq=#-3, INTERNAL_cmod$}
	loop = {
		self=<<#-1>>
		lv=lv+1;
		divides_3 = ({lv,3,0}'cmod)$;
		divides_5 = ({lv,5,0}'cmod)$;
		cond1 = ({divides_3, divides_5, 'or})$;
		sum35 = sum35 + ({cond1, sum35+lv, sum35, 'ite})$
		cond2 = ({lv, 10, 'lt})$;
		continue = <self loop>;
		exit=sum35
		answer = ({cond2, <continue>, sum35, 'ite})$
	}
	lv  = 1; sum35 = 0;
	answer = ({loop} loop)$
}
!!
{NK(ITERATION-EXCEEDED, Iteration exceeded 9999)
  INTERNALˍite={WOCONSTANIC
      cond='True;
      <<WOCONSTANIC
        #(offset=-3, UNANCHORED, ECONSTANIC)
      >>;
      cond='False;
      <<WOCONSTANIC
        #(offset=-2, UNANCHORED, ECONSTANIC)
      >>
  };
  'ite=#(offset=1, ANCHORED, NK);
  INTERNALˍcmod={WOCONSTANIC
      ?(pattern='^INTERNALˍeq$', UNANCHORED, ECONSTANIC);
      $(result=?(result=??? (modulo: non-integer operand), pattern='^'mod$', UNANCHORED, NK), NK);
      ?(result=??? (comparison: non-integer operand), pattern='^'eq$', UNANCHORED, NK)
  };
  'cmod={NK
      INTERNALˍnumerator=#(offset=-3, UNANCHORED, NK);
      INTERNALˍdivisor=#(offset=-3, UNANCHORED, NK);
      INTERNALˍeq=#(offset=-3, UNANCHORED, NK);
      $(result=?(result=??? (comparison: non-integer operand), pattern='^'eq$', UNANCHORED, NK), NK)
  };
  loop={BRANING
      self=<<WOCONSTANIC
          #(offset=-1, UNANCHORED, ECONSTANIC)
      >>;
      lv=Op+(?(pattern='^lv$', UNANCHORED, ECONSTANIC), 1, WOCONSTANIC);
      dividesˍ3 =$ ⨃( (BRANING)
          elements=2,
          {WOCONSTANIC
  ?(pattern='^lv$', UNANCHORED, ECONSTANIC);
  3;
  0
},
          ?(
  result={NK
      INTERNALˍnumerator=#(offset=-3, UNANCHORED, NK);
      INTERNALˍdivisor=#(offset=-3, UNANCHORED, NK);
      INTERNALˍeq=#(offset=-3, UNANCHORED, NK);
      $(result=?(result=??? (comparison: non-integer operand), pattern='^'eq$', UNANCHORED, NK), NK)
  },
  pattern='^'cmod$',
  UNANCHORED,
  NK
),
          BRANING
      );
      dividesˍ5 =$ ⨃( (PREMBRIONIC)
          elements=2,
          {PREMBRIONIC
  ?(pattern='^lv$', UNANCHORED, ECONSTANIC);
  5;
  0
},
          <PREMBRIONIC
  ?(pattern='^'cmod$', UNANCHORED, PREMBRIONIC)
>,
          PREMBRIONIC
      );
      cond1 =$ {PREMBRIONIC (PREMBRIONIC)
          ?(pattern='^dividesˍ3$', UNANCHORED, PREMBRIONIC);
          ?(pattern='^dividesˍ5$', UNANCHORED, PREMBRIONIC);
          ?(pattern='^'or$', UNANCHORED, PREMBRIONIC)
      };
      sum35=Op+(?(pattern='^sum35$', UNANCHORED, PREMBRIONIC), $(PREMBRIONIC), PREMBRIONIC);
      cond2 =$ {PREMBRIONIC (PREMBRIONIC)
          ?(pattern='^lv$', UNANCHORED, PREMBRIONIC);
          10;
          ?(pattern='^'lt$', UNANCHORED, PREMBRIONIC)
      };
      continue=<PREMBRIONIC
          ⨃(
            elements=2,
            <PREMBRIONIC
  ?(pattern='^self$', UNANCHORED, PREMBRIONIC)
>,
            <PREMBRIONIC
  ?(pattern='^loop$', UNANCHORED, PREMBRIONIC)
>,
            PREMBRIONIC
          )
      >;
      exit=?(pattern='^sum35$', UNANCHORED, PREMBRIONIC);
      answer =$ {PREMBRIONIC (PREMBRIONIC)
          ?(pattern='^cond2$', UNANCHORED, PREMBRIONIC);
          <PREMBRIONIC
            ?(pattern='^continue$', UNANCHORED, PREMBRIONIC)
          >;
          ?(pattern='^sum35$', UNANCHORED, PREMBRIONIC);
          ?(pattern='^'ite$', UNANCHORED, PREMBRIONIC)
      }
  };
  lv=1;
  sum35=0;
  answer =$ ⨃( (PREMBRIONIC)
      elements=2,
      {PREMBRIONIC
  ?(pattern='^loop$', UNANCHORED, ECONSTANIC)
},
      <PREMBRIONIC
