{
	!! FOOP-65 — tail concatenator chain: §3.1 worked example.
	!! The backtick form and juxtaposition form produce identical settled branes.

	!! Define operands
	a_val = 1;
	b_val = 2;
	c_val = 3;
	d_val = 4;
	e_val = 5;
	f_val = 6;

	!! Backtick form: a_val`b_val`c_val`d_val e_val f_val
	!! This is: (d_val e_val f_val) c_val b_val a_val
	chain_backtick = a_val`b_val`c_val`d_val e_val f_val;

	!! Juxtaposition form (reversed source order = same concatenation)
	chain_juxta    = d_val e_val f_val c_val b_val a_val;
}
