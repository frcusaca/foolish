{
  !! Constants
  a = 1;
  b = 2;
  c = 3;
  
  !! Operators
  sum = a + b;
  product = a * b;
  divide = a / b;
  subtract = a - b;
  
  !! NK from division by zero
  bad = 1 / 0;
  
  !! Nested brane
  inner = {
    x = 10;
    y = 20;
    z = x + y;
  };
  
  !! Search
  found = a;
  
  !! SF (StayFoolish)
  sf_val = <a>;
  
  !! SFF (StayFullyFoolish)
  sff_val = <<b>>;
  
  !! Concatenation
  concat = {p = 1; q = 2} ⨃ {r = 3; s = 4};
  
  !! Index
  idx = inner#0;
  
  !! Head/Tail
  hd = inner^;
  tl = inner$;
  
  !! Forward reference
  fwd = later;
  later = 99;
  
  !! Deeply nested
  deep = {
    level1 = {
      level2 = {
        level3 = {
          val = 42;
        };
      };
    };
  };
  
  !! Search through nesting
  deep_search = deep.level1.level2.level3.val;
  
  !! Result
  result = sum + product;
}
