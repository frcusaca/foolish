{
	!! Integer comparators — Unicode underlined + ASCII \o forms

	!! --- ASCII \o form ---
	alt = 3 \o< 5;
	ale = 3 \o<= 3;
	agt = 5 \o> 3;
	age = 5 \o>= 5;
	aeq = 3 \o== 3;

	!! --- false cases ---
	false_lt = 5 \o< 3;
	false_le = 5 \o<= 3;
	false_gt = 3 \o> 5;
	false_ge = 3 \o>= 5;
	false_eq = 2 \o== 3;

	!! --- boundary ---
	zero = 0 \o<= 0;
	neg = -5 \o<= -3;
	neg_ge = -3 \o>= -5;
	neg_eq = -3 \o== -3;

	!! --- non-integer operands → NK ---
	nk_creation = ⬤ \o<= 3;
	nk_brane = {x=1;} \o>= 0;
	nk_eq = ⬤ \o== ⬤;
}
