sections: INPUT, OUTPUT, COMMENTS, STAMPS①
{
	!! FOOP-33 §5.0: the five comparison operators are null-characterized creations in
	!! system.foo ('lt/'gt/'le/'ge/'eq), reached by the SAME ordinary ancestral search that
	!! finds 'True/'False -- no parse-time or name-based special-casing.
	!! --
	!! Placement is POSTFIX: both operands precede the operator, which reads them as
	!! <<#-2>> op <<#-1>>. The computed boolean becomes the brane's TAIL, and $ reads it out.
	!! The mechanism is ordinary detachment and recoordination: the operand lookups sit
	!! ECONSTANIC inside system.foo and resolve once recoordinated into the brane below.
	!! --
	!! The sequencer renders each result by the name of the creation it settled to, so each
	!! line's comment states which boolean it IS.

	lt_true  = {1, 2, 'lt}$;    !! 1 < 2  -> 'True
	lt_false = {2, 1, 'lt}$;    !! 2 < 1  -> 'False

	gt_true  = {2, 1, 'gt}$;    !! 2 > 1  -> 'True
	gt_false = {1, 2, 'gt}$;    !! 1 > 2  -> 'False

	le_true  = {2, 2, 'le}$;    !! 2 <= 2 -> 'True
	le_false = {2, 1, 'le}$;    !! 2 <= 1 -> 'False

	ge_true  = {2, 2, 'ge}$;    !! 2 >= 2 -> 'True
	ge_false = {1, 2, 'ge}$;    !! 1 >= 2 -> 'False

	eq_true  = {3, 3, 'eq}$;    !! 3 == 3 -> 'True
	eq_false = {3, 4, 'eq}$;    !! 3 != 4 -> 'False
}
①
{
  ltˍtrue = 'True;
  ltˍfalse = 'False;
  gtˍtrue = 'True;
  gtˍfalse = 'False;
  leˍtrue = 'True;
  leˍfalse = 'False;
  geˍtrue = 'True;
  geˍfalse = 'False;
  eqˍtrue = 'True;
  eqˍfalse = 'False
}①
