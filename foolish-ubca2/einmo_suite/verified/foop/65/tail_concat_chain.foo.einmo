	!! FOOP-65 — tail concatenator chain: §3.1 worked example.
	!! The backtick form and juxtaposition form produce identical settled branes.

	!! Define operands
	a_brn = {1};
	b_brn = {2};
	c_brn = {3};
	d_brn = {4};
	e_brn = {5};
	f_brn = {6};

	!! Backtick form: a_brn`b_brn`c_brn`d_brn e_brn f_brn
	!! This is: (d_brn e_brn f_brn) c_brn b_brn a_brn
	chain_backtick = a_brn`b_brn`c_brn`d_brn e_brn f_brn;

	!! Juxtaposition form (reversed source order = same concatenation)
	chain_juxta    = d_brn e_brn f_brn c_brn b_brn a_brn;
}
①
