sections: INPUT, OUTPUT, COMMENTS, STAMPS①
{
	!! FOOP-33 §5: "only integers are comparable". When an operand DID evaluate here but is
	!! not an integer, the comparison settles NK rather than inventing an ordering. This is
	!! the NK case that is legitimate for a comparison -- distinct from the ECONSTANIC state
	!! the operator holds inside system.foo, where the operands never evaluated at all.

	brane_operand   = {1, {x = 5;}, 'lt}$;    !! a brane is not comparable -> NK
	creation_operand = {1, ⬤, 'lt}$;          !! a creation is not comparable -> NK
	unknown_operand = {1, ???, 'lt}$;         !! ??? is not comparable -> NK

	!! A lone operand: #-2 reaches past the front of the brane, so there is no first operand
	!! to compare -> NK. The reason reads "non-integer operand" because a missing operand is
	!! indeed not an integer -- one reason covers both shapes of incomparable operand.
	only_one = {7, 'lt}$;
}
①
{
  braneˍoperand =$ {1; {x = 5}; 'lt};  !! NK: comparison: non-integer operand
  creationˍoperand =$ {1; ⬤; 'lt};  !! NK: comparison: non-integer operand
  unknownˍoperand =$ {1; ???; 'lt};  !! NK: comparison: non-integer operand
  onlyˍone =$ {7; 'lt}  !! NK: comparison: non-integer operand
}①
