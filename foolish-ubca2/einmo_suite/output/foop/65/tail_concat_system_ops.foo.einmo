sections: INPUT, OUTPUT, COMMENTS, STAMPS①
{
	!! FOOP-65 — system-operator application and backtick equivalence.

	!! System operators use the brane application idiom: {args, 'op}$
	lt_true  = {1, 2, 'lt}$;
	lt_false = {2, 1, 'lt}$;
	eq_true  = {3, 3, 'eq}$;

	!! Backtick equivalence for user-defined brane application: myfn`{a=10, b=-3} reverses to
	!! {a=10, b=-3} myfn — an identical brane.
	myfn = {result = a + b;};
	r_backtick = myfn`{a=10, b=-3};
	r_juxta    = {a=10, b=-3} myfn;
}
①
{
  ltˍtrue = 'True;
  ltˍfalse = 'False;
  eqˍtrue = 'True;
  myfn = {
    result = a + b
  };
  rˍbacktick = {
    a = 10;
    b = -3;
    result = 7
  };
  rˍjuxta = {
    a = 10;
    b = -3;
    result = 7
  }
}①
