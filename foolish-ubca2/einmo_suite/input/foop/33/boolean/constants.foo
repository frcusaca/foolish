{
	!! FOOP-33 §4: 'True and 'False resolve as ordinary ancestral (sibling) lookups into
	!! system.foo, composed as the implicit root ancestor of every program. The LEADING
	!! QUOTE is required: a bare True can never match the null-characterized 'True, since
	!! searchable_name comparison is unconditional (FOOP-33.md §3 "quote-bearing search").
	!! The sequencer renders each result by the creation's own name, not the bare ⬤.
	t1 = 'True;
	t2 = 'True;
	f1 = 'False;
}
