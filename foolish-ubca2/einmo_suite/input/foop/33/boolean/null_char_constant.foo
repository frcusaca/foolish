{
	!! FOOP-86 §6: 'True is a null-characterized name constant in system.foo. Re-stating it
	!! to an EQUAL value is permitted; a CONFLICTING redefinition is unsteppable (§6.2 route
	!! 1), so the brane cannot finish stepping and HALTS, taking NK (§6.3). Here the
	!! unsteppable statement is the last one, 'True = 3, and nothing follows it, so the
	!! brane's opener carries the annotation. It is the CAUSE, not a casualty: it reverts to
	!! Foolish keeping its written 3, and the earlier readers still find the established
	!! 'True (§6.1).
	restate = 'True;
	'True = 'True;
	conflict = 'True;
	'True = 3;
}
