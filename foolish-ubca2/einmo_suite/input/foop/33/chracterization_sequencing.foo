{

  is_it = 'True; !! system creation renders as 'True

  !! a creation renders as ⬤ at its creation site; these LHS names are
  !! those creations' original names
  'a    = {*};
   a    = {*};

  !! 'bad='b renames an already-named creation -- unsteppable (§6.2 route 4),
  !! so bs halts and takes NK; its opener carries the annotation
  bs    = {b={*}; 'b={*}; 'bad='b};

  !! Can we see the names now?
  what_was_tick_a = 'a;
  what_was_tick_a = #-4;

  !! a non-null-characterized name is not rendered, so these revert to Foolish
  what_was_a = a;
  what_was_a = ?='a&#1;  !! defined on the line after 'a

  !! control: gs is the SAME shape as bs but WITHOUT the unsteppable
  !! statement, so anchored searches into it RESOLVE -- no NK below.
  !! They still revert to Foolish: the creation found is named inside gs,
  !! and that name is not in scope out here (§N4.b)
  gs    = {b={*}; 'b={*}};
  good_tick_b = gs?'b;
  good_b      = gs?b;
  good_index  = gs#1;

  !! all of the following fail to NK because bs is an NK brane, due to its
  !! unsteppable statement -- the names ARE in bs; the brane is refused (§6.4b)
  what_is_tick_b_called_from_another_brane_1 = bs.'b;
  what_is_tick_b_called_from_another_brane_2 = bs~'b;
  what_is_tick_b_called_from_another_brane_3 = bs?'b;
  what_is_tick_b_called_from_another_brane_4 = bs#1;
  what_is_b_called_from_another_brane_1      = bs.b;
  what_is_b_called_from_another_brane_2      = bs#0;
  'how_bad_can_it_b_1                        = bs#1;
  how_bad_can_it_b_2                         = bs#1;
}
