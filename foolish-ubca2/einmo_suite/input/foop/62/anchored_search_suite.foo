{
  hw = {
     hello = 1;
     world = 2;
     how   = 3;
     are   = 4;
     you   = 5;
     today = 6;
  };
  how_is        = hw.how;
  how_is_also   = hw~how;
  how_is_also   = hw?(h.*);
  how_is_also   = hw~(.o.);
  how_is_not    = hw?(ho);
  how_is_fuzzy  = hw?(^ho);
  hello_is      = hw~(h.*);
  hello_fuzzy   = hw~(^h);
  hello_fuzzy2  = hw?(^he);
  you_is        = hw?(.o.);
  world_is      = hw~(.o...);
  today_is      = hw?(.o...);
}
