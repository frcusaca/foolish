{
	!! FOOP-65 — tail concatenator basic equivalence pairs.
	!! Each pair: backtick form next to juxtaposition form, settling identically.

	!! Define brane values to use as operands (concatenation requires branes)
	lhs = {x=1;};
	rhs = {y=2;};

	!! Pair 1: two brane variables — backtick vs juxtaposition
	p1_backtick = lhs`rhs;
	p1_juxta    = rhs lhs;

	!! Pair 2: two brane literals
	p2_backtick = {a=10;}`{b=20;};
	p2_juxta    = {b=20;} {a=10;};
}
