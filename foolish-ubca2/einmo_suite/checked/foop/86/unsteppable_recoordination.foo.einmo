  !!!
  FOOP-86 §6.2 route 3 -- RECOORDINATION. A statement whose settled value is a brane brings that
  brane's members into this context; if one of them null-characterizes a name ALREADY defined here
  with a DIFFERENT value, the coordination is refused.

  Route 3 is the one route that does NOT halt its brane: only the statement holding the value settles
  NK (an ordinary NK), and the receiving brane's other statements step normally (§6.4c). Rendering
  follows §6.5's ordinary NK-reverts-to-Foolish rule, not §5.2's brane exception.
  !!!

  A = {'C = 1};

  !! 'C is already 2 here, so coordinating A in would give 'C a second meaning. THIS statement is the
  !! unsteppable one: it reverts to its written `A` and carries an NK annotation.
  B = {'C = 2; D = A; after = 7};

  !! The conflict is with the RECEIVING context, not with A, so every access into A resolves normally.
  a_is_fine = A.'C;

  !! The SAME value is not a conflict -- coordinating it in is permitted.
  ok = {'C = 1; E = A};
}
①
{
  A = {
    'C = 1
  };
  B = {
    'C = 2;
    D = A;  !! NK: 'C already defined in context
    after = 7
  };
  aˍisˍfine = 1;
  ok = {
    'C = 1;
    E = {
      'C = 1
    }
  }
}①
