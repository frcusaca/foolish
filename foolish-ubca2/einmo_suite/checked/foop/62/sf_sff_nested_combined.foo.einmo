{
   x=1;
   y=2;
   sff = <<x+y>>;
   sf  = <x+y>;
   sfsff = <sff>;
   sffsf = <<sf>>;
   sfsf  = <sf>;
   sffsff = <<sff>>;

   x=-2;
   rsff   = sff;
   rsf    = sf;
   rsfsff = sfsff;
   rsffsf = sffsf;
   rsfsf  = sfsf;
   rsffsff= sffsff;
}
①
{WOCONSTANIC
  x=1;
  y=2;
  sff=<<WOCONSTANIC
      Op+(?(pattern='^x$', UNANCHORED, ECONSTANIC), ?(pattern='^y$', UNANCHORED, ECONSTANIC), WOCONSTANIC)
  >>;
  sf=3;
  sfsff=?(
      result=Op+(?(pattern='^x$', UNANCHORED, ECONSTANIC), ?(pattern='^y$', UNANCHORED, ECONSTANIC), WOCONSTANIC),
      pattern='^sff$',
      UNANCHORED,
      WOCONSTANIC
  );
  sffsf=<<WOCONSTANIC
      ?(pattern='^sf$', UNANCHORED)
  >>;
  sfsf=?(result=3, pattern='^sf$', UNANCHORED);
  sffsff=<<WOCONSTANIC
      ?(pattern='^sff$', UNANCHORED)
  >>;
  x=-2;
  rsff=0;
  rsf=3;
  rsfsff=0;
  rsffsf=?(result=3, pattern='^sf$', UNANCHORED);
  rsfsf=3;
  rsffsff=0
}①
