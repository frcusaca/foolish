{!!system.foo
	'True  = ⬤
	'False = ⬤
	'lt    = ⬤    !! less-than: <<#-2>> < <<#-1>>
	'gt    = ⬤    !! greater-than: <<#-2>> > <<#-1>>
	'le    = ⬤    !! less-or-equal: <<#-2>> <= <<#-1>>
	'ge    = ⬤    !! greater-or-equal: <<#-2>> >= <<#-1>>
	'eq    = ⬤    !! equality: <<#-2>> == <<#-1>>
	'mod   = ⬤    !! modulo: <<#-2>> % <<#-1>>
	'or    = ⬤    !! boolean OR: <<#-2>> || <<#-1>>
	'min_int_val = ⬤    !! smallest integer among the preceding members (FOOP-55 §7)
	'max_int_val = ⬤    !! largest integer among the preceding members (FOOP-55 §7)
}
