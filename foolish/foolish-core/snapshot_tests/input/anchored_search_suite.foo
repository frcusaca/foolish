{
  hw = {
     hello = 1;
     world = 2;
     how   = 3;
     are   = 4;
     you   = 5;
     today = 6;
  };
  how_is      = hw.how;
  how_is_also = hw~how;
  how_is_also = hw?(h.*);
  how_is_also = hw~(.o.);
  hello_is    = hw~(h.*);
  you_is      = hw?(.o.);
  world_is    = hw~(.o...);
  today_is    = hw?(.o...);
}
