[2] RESULT:
```hssnap
Concatenation(elements=2, [EMBRYONIC])
  Search(pattern='^testˍancestralˍidentifierˍwithˍshadow$', dir=BACKWARD, UNANCHORED, [ECONSTANIC])
  Brane [EMBRYONIC]{
      a = 1;
      n1 = Brane [EMBRYONIC]{
          c = Operator(-, [EMBRYONIC])
            1;
          b = Search(pattern='^a$', dir=BACKWARD, UNANCHORED, [EMBRYONIC]);
          a = 2;
          n2 = Brane [EMBRYONIC]{
              a = 3;
              b = Search(pattern='^c$', dir=BACKWARD, UNANCHORED, [EMBRYONIC]);
              d = Operator(-, [EMBRYONIC])
                Search(pattern='^b$', dir=BACKWARD, UNANCHORED, [EMBRYONIC]);
              e = Operator(+, [EMBRYONIC])
                Operator(+, [EMBRYONIC])
                  Operator(+, [EMBRYONIC])
                    Search(pattern='^a$', dir=BACKWARD, UNANCHORED, [EMBRYONIC])
                    Search(pattern='^b$', dir=BACKWARD, UNANCHORED, [EMBRYONIC])
                  Search(pattern='^c$', dir=BACKWARD, UNANCHORED, [EMBRYONIC])
                Search(pattern='^d$', dir=BACKWARD, UNANCHORED, [EMBRYONIC])
          }
      };
      a = Search(pattern='^b$', dir=BACKWARD, UNANCHORED, [EMBRYONIC]);
      b = 1;
      c = Search(pattern='^a$', dir=BACKWARD, UNANCHORED, [EMBRYONIC])
  }
```
