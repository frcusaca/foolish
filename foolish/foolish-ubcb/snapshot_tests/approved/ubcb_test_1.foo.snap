              Operator(+, [EMBRYONIC])
                Search(pattern='^a$', dir=BACKWARD, UNANCHORED, [EMBRYONIC])
                Search(pattern='^b$', dir=BACKWARD, UNANCHORED, [EMBRYONIC])
              Search(pattern='^c$', dir=BACKWARD, UNANCHORED, [EMBRYONIC])
            Search(pattern='^d$', dir=BACKWARD, UNANCHORED, [EMBRYONIC])
      };
      g = Search(pattern='^f$', dir=BACKWARD, UNANCHORED, [EMBRYONIC]);
      d = 0;
